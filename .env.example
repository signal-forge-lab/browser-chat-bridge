# Browser Chat Bridge example environment
# Copy values into your local environment as needed. Do not commit real credentials.

# Driver / CDP
CHAT_DRIVER_CDP_ENDPOINT=http://127.0.0.1:51881
CHAT_DRIVER_BACKEND=chromium

# Optional Browser Host overrides
# CHAT_BROWSER_EDGE_EXECUTABLE=C:\path\to\msedge.exe
# CHAT_BROWSER_PROFILE=%LOCALAPPDATA%\BrowserChatBridge\Edge\User Data
# CHAT_BROWSER_ATTACH_ENDPOINT=http://127.0.0.1:9222

# Optional service URLs when components are run separately
# CHAT_BRIDGE_BROWSER_URL=http://127.0.0.1:8764
# CHAT_BRIDGE_DRIVER_URL=http://127.0.0.1:8766
